<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="004-create-table-idempotency-keys" author="luis">
        <createTable tableName="idempotency_keys">
            <column name="idempotency_key" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="endpoint" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="response_status" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="response_body" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey
                tableName="idempotency_keys"
                columnNames="idempotency_key, endpoint"
                constraintName="pk_idempotency_keys"/>

        <createIndex tableName="idempotency_keys" indexName="idx_idempotency_keys_expires_at">
            <column name="expires_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
